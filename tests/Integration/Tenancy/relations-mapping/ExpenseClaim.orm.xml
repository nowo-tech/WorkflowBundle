<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\WorkflowBundle\Tests\Integration\Tenancy\Relations\ExpenseClaim" table="host_expense_claim">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="uuid" type="string" length="64"/>
        <field name="organization" type="string" length="64"/>
        <field name="status" type="string" length="32"/>
        <many-to-one field="requester" target-entity="Nowo\WorkflowBundle\Tests\Integration\Tenancy\Relations\Employee">
            <join-column name="requester_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <many-to-one field="approver" target-entity="Nowo\WorkflowBundle\Tests\Integration\Tenancy\Relations\Employee">
            <join-column name="approver_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>
        <many-to-one field="workflowVersion" target-entity="Nowo\WorkflowBundle\Entity\WorkflowDefinition">
            <join-column name="workflow_version_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
