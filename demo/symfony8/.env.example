# Demo environment template. Copy to `.env` (e.g. `cp .env.example .env`) and adjust.
# Do not commit `.env`, `.env.dev`, or local `.env*` files (REQ-DEMO-003 / REQ-ENV-001).
#
# Inside Docker, docker-compose.yml sets DATABASE_URL to PostgreSQL on host `database`.
# Values below are safe placeholders for local demos only.

# APP_ENV: Symfony environment (dev/test/prod). Demos usually use `dev`.
APP_ENV=dev

# APP_DEBUG: enable detailed debug output (`1` in demos).
APP_DEBUG=1

# APP_SECRET: secret used for signing/tokens. Use a local-only value; never production secrets.
APP_SECRET=change_this_secret_key_to_a_random_value

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# PORT: host port published for the FrankenPHP demo (http://localhost:<PORT>).
PORT=8022

# TRUSTED_PROXIES: trusted proxies when behind Caddy/FrankenPHP.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# DEFAULT_URI: base URI used by the demo app for absolute URL generation.
DEFAULT_URI=http://localhost

# POSTGRES_*: credentials for the demo PostgreSQL service (Docker network only; no host ports).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!
POSTGRES_VERSION=16

# DATABASE_URL: Doctrine DSN. Inside Compose, hostname `database` resolves on the Docker network.
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8"

# Optional: SQLite without Postgres (local only — not used by docker-compose)
# DATABASE_URL=mysql://app:app@database:3306/app?serverVersion=8.4&charset=utf8mb4
