{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform); the Workflow pages render through it too (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _locales = [] %}
{% for locale in nowo_workflow_locales %}
    {% set _locales = _locales|merge([{code: locale, label: ('locale.' ~ locale)|trans({}, 'NowoWorkflowBundle'), href: path('demo_locale_switch', {_locale: locale})}]) %}
{% endfor %}
{% set nowo_ui_demo_platform = {
    bundle: 'Workflow',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/WorkflowBundle',
    translation_domain: 'demo',
    locales: _locales|length > 1 ? _locales : [],
    nav: [
        {label: 'nav.home', route: 'demo_home'},
        {label: 'nav.resolver', route: 'demo_resolver', section: 'nav.section_playground'},
        {label: 'nav.change_requests', route: 'demo_change_requests', active: ['demo_change_requests*'], section: 'nav.section_playground'},
        {label: 'nav.orders', route: 'demo_orders', active: ['demo_orders*'], section: 'nav.section_playground'},
        {label: 'nav.documents', route: 'demo_documents', active: ['demo_documents*'], section: 'nav.section_playground'},
        {label: 'nav.expenses', route: 'demo_expenses', active: ['demo_expenses*'], section: 'nav.section_playground'},
        {label: 'nav.purchase_orders', route: 'demo_purchase_orders', active: ['demo_purchase_orders*'], section: 'nav.section_playground'},
        {label: 'nav.crud', route: 'nowo_workflow_dashboard', active: ['nowo_workflow*'], section: 'nav.section_admin'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}{{ 'title'|trans({}, 'demo') }}{% endblock %} — Symfony 8{% endblock %}
