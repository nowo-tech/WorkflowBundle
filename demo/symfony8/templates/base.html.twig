<!DOCTYPE html>
<html lang="{{ app.request.locale }}"{% block html_attributes %}{% endblock %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'title'|trans({}, 'demo') }}{% endblock %}</title>
    {#- The demo app loads Bootstrap from a CDN (host choice); UiKit 2.0 ships nowo-ui.css in @layer nowo-ui, so the
        framework goes into the base layer below the kit (UiKit PAGE_CONTRACT.md#cascade-layers). -#}
    <style>@layer theme, base, nowo-ui, components, utilities; @import url("https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css") layer(base);</style>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="{{ path('demo_home') }}">{{ 'brand'|trans({}, 'demo') }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#demoNav" aria-controls="demoNav" aria-expanded="false" aria-label="{{ 'nav.toggle'|trans({}, 'demo') }}">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="demoNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" href="{{ path('demo_home') }}">{{ 'nav.home'|trans({}, 'demo') }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('demo_resolver') }}">{{ 'nav.resolver'|trans({}, 'demo') }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('nowo_workflow_dashboard') }}">{{ 'nav.crud'|trans({}, 'demo') }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('demo_change_requests') }}">{{ 'nav.change_requests'|trans({}, 'demo') }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('demo_orders') }}">{{ 'nav.orders'|trans({}, 'demo') }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('demo_documents') }}">{{ 'nav.documents'|trans({}, 'demo') }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('demo_expenses') }}">{{ 'nav.expenses'|trans({}, 'demo') }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('demo_purchase_orders') }}">{{ 'nav.purchase_orders'|trans({}, 'demo') }}</a></li>
                    {% if nowo_workflow_locales|length > 1 %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">{{ ('locale.' ~ app.request.locale)|trans({}, 'NowoWorkflowBundle') }}</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                {% for locale in nowo_workflow_locales %}
                                    <li><a class="dropdown-item{% if app.request.locale == locale %} active{% endif %}" href="{{ path('demo_locale_switch', {_locale: locale}) }}">{{ ('locale.' ~ locale)|trans({}, 'NowoWorkflowBundle') }}</a></li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        {% block body %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
