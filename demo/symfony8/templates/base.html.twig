{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN, inline SVG icons). The Workflow pages render in it too
    (nowo_ui_kit.layouts.admin). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'title'|trans({}, 'demo') }}{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route')|default('') %}
    {% set _locales = [] %}
    {% for locale in nowo_workflow_locales %}
        {% set _locales = _locales|merge([{
            code: locale,
            label: ('locale.' ~ locale)|trans({}, 'NowoWorkflowBundle'),
            href: path('demo_locale_switch', {_locale: locale}),
            current: locale == app.request.locale,
        }]) %}
    {% endfor %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">{{ 'brand'|trans({}, 'demo') }}</a>
        <nav class="nowo-ui-menu" aria-label="{{ 'brand'|trans({}, 'demo') }}">
            <a class="nowo-ui-link" href="{{ path('demo_home') }}"{% if _route == 'demo_home' %} aria-current="page"{% endif %}>{{ 'nav.home'|trans({}, 'demo') }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_resolver') }}"{% if _route == 'demo_resolver' %} aria-current="page"{% endif %}>{{ 'nav.resolver'|trans({}, 'demo') }}</a>
            <a class="nowo-ui-link" href="{{ path('nowo_workflow_dashboard') }}"{% if _route starts with 'nowo_workflow' %} aria-current="page"{% endif %}>{{ 'nav.crud'|trans({}, 'demo') }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_change_requests') }}"{% if _route == 'demo_change_requests' %} aria-current="page"{% endif %}>{{ 'nav.change_requests'|trans({}, 'demo') }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_orders') }}"{% if _route == 'demo_orders' %} aria-current="page"{% endif %}>{{ 'nav.orders'|trans({}, 'demo') }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_documents') }}"{% if _route == 'demo_documents' %} aria-current="page"{% endif %}>{{ 'nav.documents'|trans({}, 'demo') }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_expenses') }}"{% if _route == 'demo_expenses' %} aria-current="page"{% endif %}>{{ 'nav.expenses'|trans({}, 'demo') }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_purchase_orders') }}"{% if _route == 'demo_purchase_orders' %} aria-current="page"{% endif %}>{{ 'nav.purchase_orders'|trans({}, 'demo') }}</a>
        </nav>
        <div class="nowo-ui-header__end">
            {% if _locales|length > 1 %}
                {{ include('@NowoUiKitBundle/partials/_locale_switcher.html.twig', { locales: _locales, current: app.request.locale, compact: true }, false) }}
            {% endif %}
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
