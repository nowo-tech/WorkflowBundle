{% extends 'base.html.twig' %}

{% block title %}{{ 'playground.orders.title'|trans({}, 'demo') }}{% endblock %}

{% block body %}
    <div class="nowo-ui-page-header"><h1 class="nowo-ui-page-header__title">{{ 'playground.orders.title'|trans({}, 'demo') }}</h1></div>

    <div class="nowo-ui-flash nowo-ui-flash--info">
        {{ 'playground.orders.hint'|trans({}, 'demo') }}
        <a href="{{ path('demo_change_requests') }}">{{ 'nav.change_requests'|trans({}, 'demo') }}</a>.
    </div>

    {{ form_start(create_form) }}
        <section class="nowo-ui-card">
            <div class="nowo-ui-card__body">
                <div class="nowo-ui-form__columns">
                {% for child in create_form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                </div>
                <div class="nowo-ui-form__actions">
                    <button type="submit" class="nowo-ui-btn nowo-ui-btn--primary">{{ 'playground.orders.create'|trans({}, 'demo') }}</button>
                </div>
            </div>
        </section>
    {{ form_end(create_form) }}

    {% for item in orders %}
        <section class="nowo-ui-card">
            <div class="nowo-ui-card__body">
                <div class="nowo-ui-card__toolbar">
                    <strong>#{{ item.entity.id }}</strong>
                    <span>{{ item.entity.title }}</span>
                    <span class="nowo-ui-badge nowo-ui-badge--primary">{{ item.marking }}</span>
                </div>
                <p class="nowo-ui-muted">{{ 'playground.resolved'|trans({}, 'demo') }}: <code class="nowo-ui-code">{{ item.workflow_slug }}</code></p>
                <div class="nowo-ui-card__toolbar">
                    {% for transition in item.transitions %}
                        {% set transition_form = item.transition_forms[transition] %}
                        {{ form_start(transition_form) }}
                            {% for child in transition_form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
                            <button type="submit" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">{{ transition }}</button>
                        {{ form_end(transition_form) }}
                    {% endfor %}
                </div>
            </div>
        </section>
    {% else %}
        <p class="nowo-ui-muted">{{ 'playground.no_items'|trans({}, 'demo') }}</p>
    {% endfor %}
{% endblock %}
