{% extends 'base.html.twig' %}

{% block title %}{{ 'playground.change_requests.title'|trans({}, 'demo') }}{% endblock %}

{% block body %}
    <div class="nowo-ui-page-header"><h1 class="nowo-ui-page-header__title">{{ 'playground.change_requests.title'|trans({}, 'demo') }}</h1></div>
    <p class="nowo-ui-muted">
            {{ 'playground.change_requests.intro'|trans({'%entity%': 'DemoChangeRequest', '%workflow%': 'change_request_review'}, 'demo') }}
        </p>

    {% if workflow_definition is null %}
        <div class="nowo-ui-flash nowo-ui-flash--warning">
            {{ 'playground.change_requests.seed_warning'|trans({'%command%': 'php bin/console nowo:workflow:seed-demo'}, 'demo') }}
        </div>
    {% endif %}

    <div class="nowo-ui-flash nowo-ui-flash--info">
        {{ 'playground.change_requests.try_path'|trans({}, 'demo') }}
        <a href="{{ path('nowo_workflow_definition_show_by_slug', {slug: 'change_request_review'}) }}">{{ 'playground.change_requests.view_diagram'|trans({}, 'demo') }}</a>
    </div>

    <div class="nowo-ui-cards">
        {% for key, tone in {happy_path: 'success', changes_loop: 'warning', rejection_loop: 'danger'} %}
            <section class="nowo-ui-card">
                <div class="nowo-ui-card__body">
                    <h2 class="nowo-ui-card__title"><span class="nowo-ui-badge nowo-ui-badge--{{ tone }}">{{ ('playground.change_requests.' ~ key)|trans({}, 'demo') }}</span></h2>
                    <p class="nowo-ui-muted">{{ ('playground.change_requests.' ~ key ~ '_desc')|trans({}, 'demo') }}</p>
                </div>
            </section>
        {% endfor %}
    </div>

    {{ form_start(create_form) }}
        <section class="nowo-ui-card">
            <div class="nowo-ui-card__body">
                <div class="nowo-ui-form__columns">
                {% for child in create_form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                </div>
                <div class="nowo-ui-form__actions">
                    <button type="submit" class="nowo-ui-btn nowo-ui-btn--primary">{{ 'playground.change_requests.create'|trans({}, 'demo') }}</button>
                </div>
            </div>
        </section>
    {{ form_end(create_form) }}

    {% for item in change_requests %}
        <section class="nowo-ui-card">
            <div class="nowo-ui-card__body">
                <div class="nowo-ui-card__toolbar">
                    <strong>#{{ item.entity.id }}</strong>
                    <span>{{ item.entity.title }}</span>
                    <span class="nowo-ui-badge nowo-ui-badge--primary">{{ item.marking|replace({'_': ' '})|title }}</span>
                </div>
                <p class="nowo-ui-muted">{{ 'playground.resolved'|trans({}, 'demo') }}: <code class="nowo-ui-code">{{ item.workflow_slug }}</code></p>
                <div class="nowo-ui-card__toolbar">
                    {% for transition in item.transitions %}
                        {% set transition_form = item.transition_forms[transition] %}
                        {{ form_start(transition_form) }}
                            {% for child in transition_form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
                            <button type="submit" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">{{ transition|replace({'_': ' '})|title }}</button>
                        {{ form_end(transition_form) }}
                    {% else %}
                        <span class="nowo-ui-muted">{{ 'playground.no_transitions'|trans({}, 'demo') }}</span>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% else %}
        <p class="nowo-ui-muted">{{ 'playground.no_items'|trans({}, 'demo') }}</p>
    {% endfor %}
{% endblock %}
