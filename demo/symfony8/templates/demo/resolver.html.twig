{% extends 'base.html.twig' %}

{% block title %}{{ 'playground.resolver.title'|trans({}, 'demo') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'playground.resolver.title'|trans({}, 'demo'), intro: 'playground.resolver.intro'|trans({}, 'demo')}) }}
{% endblock %}

{% block nowo_ui_flashes %}
    {% if error %}
        {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: {error: ['playground.resolver.error'|trans({}, 'demo') ~ ': ' ~ error]}}) }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'playground.resolver.title'|trans({}, 'demo'), kind: 'form', filter_form: filter_form} %}
        {% block section_body %}
            {{ form_start(filter_form, {attr: {id: 'resolver-form'}}) }}
                    {% for child in filter_form %}
                        {% if not child.rendered %}{{ form_row(child) }}{% endif %}
                    {% endfor %}
            {{ form_end(filter_form) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="resolver-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ 'playground.resolver.resolve'|trans({}, 'demo') }}</button>
        {% endblock %}
    {% endembed %}

    {% if resolved %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'playground.resolver.resolved'|trans({}, 'demo'), kind: 'detail', resolved: resolved} %}
            {% block section_body %}
                <p><strong>{{ resolved.name }}</strong> (<code class="nowo-ui-code">{{ resolved.slug }}</code>)</p>
                <p class="nowo-ui-muted">Priority {{ resolved.priority }} · {{ resolved.matchRules|length }} rule(s)</p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% if matches %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'playground.resolver.all_matches'|trans({}, 'demo'), kind: 'table', matches: matches} %}
            {% block section_body %}
                <table class="nowo-ui-data-table">
                    <thead>
                        <tr><th scope="col">Slug</th><th scope="col" class="nowo-ui-cell--wrap">{{ 'playground.resolver.rules'|trans({}, 'demo') }}</th><th scope="col" class="nowo-ui-cell--num">Priority</th><th scope="col" class="nowo-ui-cell--num">{{ 'playground.resolver.specificity'|trans({}, 'demo') }}</th></tr>
                    </thead>
                    <tbody>
                        {% for match in matches %}
                            <tr>
                                <td><code class="nowo-ui-code">{{ match.slug }}</code></td>
                                <td class="nowo-ui-cell--wrap">
                                    {% if match.defaultMatcher %}<em>default</em>{% else %}
                                        {% for rule in match.matchRules %}{{ rule.parameterKey }}={{ rule.parameterValue }} {% endfor %}
                                    {% endif %}
                                </td>
                                <td class="nowo-ui-cell--num">{{ match.priority }}</td>
                                <td class="nowo-ui-cell--num">{{ match.matchRules|length }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
