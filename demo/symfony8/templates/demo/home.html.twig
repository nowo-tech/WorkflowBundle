{% extends 'base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'demo') }}{% endblock %}

{% block body %}
    <div class="nowo-ui-page-header">
        <h1 class="nowo-ui-page-header__title">{{ 'title'|trans({}, 'demo') }} <span class="nowo-ui-badge nowo-ui-badge--primary">{{ version_badge }}</span></h1>
    </div>
    <p class="nowo-ui-muted">{{ 'lead'|trans({}, 'demo') }}</p>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">{{ 'home.branching.title'|trans({}, 'demo') }}</h2></div>
        <div class="nowo-ui-card__body">
            <p>{{ 'home.branching.text'|trans({'%entity%': 'DemoChangeRequest'}, 'demo') }}</p>
            <div class="nowo-ui-card__toolbar">
                <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('demo_change_requests') }}">{{ 'home.branching.playground'|trans({}, 'demo') }}</a>
                <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('nowo_workflow_definition_show_by_slug', {slug: 'change_request_review'}) }}">{{ 'home.branching.diagram'|trans({}, 'demo') }}</a>
            </div>
        </div>
    </section>

    <div class="nowo-ui-cards">
        {% for key, spec in {
            resolver: {entity: null, route: 'demo_resolver', style: 'primary'},
            orders: {entity: 'DemoOrder', route: 'demo_orders', style: 'primary'},
            documents: {entity: 'DemoDocument', route: 'demo_documents', style: 'primary'},
            expenses: {entity: 'DemoExpense', route: 'demo_expenses', style: 'primary'},
            purchase_orders: {entity: 'DemoPurchaseOrder', route: 'demo_purchase_orders', style: 'primary'},
            crud: {entity: null, route: 'nowo_workflow_dashboard', style: 'outline'},
        } %}
            <section class="nowo-ui-card">
                <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">{{ ('home.' ~ key ~ '.title')|trans({}, 'demo') }}</h2></div>
                <div class="nowo-ui-card__body">
                    <p class="nowo-ui-muted">{{ ('home.' ~ key ~ '.text')|trans(spec.entity ? {'%entity%': spec.entity} : {}, 'demo') }}</p>
                    <a class="nowo-ui-btn nowo-ui-btn--{{ spec.style }}" href="{{ path(spec.route) }}">{{ ('home.' ~ key ~ '.action')|trans({}, 'demo') }}</a>
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
