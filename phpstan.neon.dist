parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - vendor/*
        # Since 2.0: host classes that still implement a removed port; they cannot be loaded by design.
        - tests/Support/Removed/*
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []

includes:
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
    - phpstan-search-kit.php
