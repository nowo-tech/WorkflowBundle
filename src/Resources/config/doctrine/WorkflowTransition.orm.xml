<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.14.0: XML mapping of the bundle entity (same tables, columns, indexes and constraints as its attributes).
     Used with nowo_workflow.doctrine.mapping_type: xml, or by a host that maps the bundle entities itself. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\WorkflowBundle\Entity\WorkflowTransition" table="workflow_transition">
        <unique-constraints>
            <unique-constraint name="uniq_workflow_transition_name" columns="workflow_id,name"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="name" type="string" length="128"/>
        <field name="label" type="string" length="255" nullable="true"/>
        <field name="labelKey" column="label_key" type="string" length="255" nullable="true"/>
        <field name="labelDomain" column="label_domain" type="string" length="128" nullable="true"/>
        <field name="fromPlaces" column="from_places" type="json"/>
        <field name="toPlaces" column="to_places" type="json"/>
        <field name="guardPermission" column="guard_permission" type="string" length="128" nullable="true"/>
        <field name="guardExpression" column="guard_expression" type="text" nullable="true"/>
        <field name="automatic" type="boolean">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <many-to-one field="workflow" target-entity="Nowo\WorkflowBundle\Entity\WorkflowDefinition" inversed-by="transitions">
            <join-column nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
