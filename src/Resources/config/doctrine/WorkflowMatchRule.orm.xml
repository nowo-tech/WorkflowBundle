<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.14.0: XML mapping of the bundle entity (same tables, columns, indexes and constraints as its attributes).
     Used with nowo_workflow.doctrine.mapping_type: xml, or by a host that maps the bundle entities itself. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\WorkflowBundle\Entity\WorkflowMatchRule" table="workflow_match_rule">
        <unique-constraints>
            <unique-constraint name="uniq_workflow_match_rule" columns="workflow_id,parameter_key"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="parameterKey" column="parameter_key" type="string" length="128"/>
        <field name="parameterValue" column="parameter_value" type="string" length="255"/>
        <field name="metadata" type="json"/>
        <field name="sortOrder" column="sort_order" type="integer"/>
        <many-to-one field="workflow" target-entity="Nowo\WorkflowBundle\Entity\WorkflowDefinition" inversed-by="matchRules">
            <join-column nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
