<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.14.0: XML mapping of the bundle entity (same tables, columns, indexes and constraints as its attributes).
     Used with nowo_workflow.doctrine.mapping_type: xml, or by a host that maps the bundle entities itself. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\WorkflowBundle\Entity\WorkflowDefinition" table="workflow_definition" repository-class="Nowo\WorkflowBundle\Repository\WorkflowDefinitionRepository">
        <unique-constraints>
            <unique-constraint name="uniq_workflow_definition_slug" columns="slug"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="name" type="string" length="128"/>
        <field name="slug" type="string" length="128"/>
        <field name="type" type="string" length="32" enum-type="Nowo\WorkflowBundle\Enum\WorkflowType"/>
        <field name="initialPlace" column="initial_place" type="string" length="128"/>
        <field name="subjectClass" column="subject_class" type="string" length="255"/>
        <field name="markingProperty" column="marking_property" type="string" length="128"/>
        <field name="enabled" type="boolean"/>
        <field name="description" type="text" nullable="true"/>
        <field name="priority" type="integer">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="metadata" type="json"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
        <one-to-many field="matchRules" target-entity="Nowo\WorkflowBundle\Entity\WorkflowMatchRule" mapped-by="workflow" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
            <order-by>
                <order-by-field name="sortOrder" direction="ASC"/>
                <order-by-field name="parameterKey" direction="ASC"/>
            </order-by>
        </one-to-many>
        <one-to-many field="places" target-entity="Nowo\WorkflowBundle\Entity\WorkflowPlace" mapped-by="workflow" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
            <order-by>
                <order-by-field name="sortOrder" direction="ASC"/>
                <order-by-field name="name" direction="ASC"/>
            </order-by>
        </one-to-many>
        <one-to-many field="transitions" target-entity="Nowo\WorkflowBundle\Entity\WorkflowTransition" mapped-by="workflow" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
            <order-by>
                <order-by-field name="name" direction="ASC"/>
            </order-by>
        </one-to-many>
    </entity>
</doctrine-mapping>
