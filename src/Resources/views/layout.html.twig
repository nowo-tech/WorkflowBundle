<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'page.dashboard'|trans({}, 'NowoWorkflowBundle') }}{% endblock %} · {{ 'title_suffix'|trans({}, 'NowoWorkflowBundle') }}</title>
    {% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        {% if nowo_workflow_icon_set == 'bootstrap-icons' %}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        {% endif %}
    {% elseif nowo_workflow_css_framework == 'tailwind' %}
        <script src="https://cdn.tailwindcss.com"></script>
    {% elseif nowo_workflow_css_framework == 'foundation' %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/css/foundation.min.css">
    {% endif %}
    <style>
        .collection-item { border: 1px dashed currentColor; border-radius: 0.375rem; opacity: 0.85; }
        .nowo-ui-modal[hidden] { display: none !important; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}bg-light{% elseif nowo_workflow_css_framework == 'tailwind' %}bg-slate-100 text-slate-900{% endif %}">
    <nav class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4{% elseif nowo_workflow_css_framework == 'tailwind' %}bg-slate-900 text-white mb-6{% elseif nowo_workflow_css_framework == 'foundation' %}top-bar mb-4{% else %}nowo-ui-toolbar{% endif %}">
        <div class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}container{% elseif nowo_workflow_css_framework == 'tailwind' %}mx-auto flex max-w-6xl items-center justify-between px-4 py-3{% else %}grid-container{% endif %}">
            <a class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}navbar-brand fw-semibold{% elseif nowo_workflow_css_framework == 'tailwind' %}font-semibold{% else %}menu-text{% endif %}" href="{{ path('nowo_workflow_dashboard') }}">{{ 'brand'|trans({}, 'NowoWorkflowBundle') }}</a>
            <ul class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}navbar-nav ms-auto align-items-lg-center{% elseif nowo_workflow_css_framework == 'tailwind' %}flex gap-4 text-sm{% else %}menu{% endif %}">
                <li class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}nav-item{% endif %}">
                    <a class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}nav-link{% elseif nowo_workflow_css_framework == 'tailwind' %}hover:text-slate-300{% endif %}" href="{{ path('nowo_workflow_dashboard') }}">{{ 'nav.dashboard'|trans({}, 'NowoWorkflowBundle') }}</a>
                </li>
                <li class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}nav-item{% endif %}">
                    <a class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}nav-link{% elseif nowo_workflow_css_framework == 'tailwind' %}hover:text-slate-300{% endif %}" href="{{ path('nowo_workflow_definition_index') }}">{{ 'nav.definitions'|trans({}, 'NowoWorkflowBundle') }}</a>
                </li>
                <li class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}nav-item{% endif %}">
                    <a class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}nav-link{% elseif nowo_workflow_css_framework == 'tailwind' %}hover:text-slate-300{% endif %}" href="{{ path('nowo_workflow_definition_new') }}">{{ 'nav.new_definition'|trans({}, 'NowoWorkflowBundle') }}</a>
                </li>
                {% include '@NowoWorkflowBundle/_locale_switcher.html.twig' %}
            </ul>
        </div>
    </nav>

    <main class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}container pb-5{% elseif nowo_workflow_css_framework == 'tailwind' %}mx-auto max-w-6xl px-4 pb-10{% elseif nowo_workflow_css_framework == 'foundation' %}grid-container{% else %}nowo-ui-content{% endif %}">
        {% block nowo_ui_flashes %}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="nowo-ui-flash nowo-ui-flash--{{ label == 'error' ? 'error' : label }} {% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show{% elseif nowo_workflow_css_framework == 'tailwind' %}mb-4 rounded-lg border px-4 py-3 text-sm{% endif %}" role="alert">
                        {{ message|trans({}, 'NowoWorkflowBundle') }}
                        {% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'action.close'|trans({}, 'NowoWorkflowBundle') }}"></button>
                        {% endif %}
                    </div>
                {% endfor %}
            {% endfor %}
        {% endblock %}

        {% block body %}{% endblock %}
        {% block nowo_ui_content %}{% endblock %}
        {% block nowo_ui_modals %}{% endblock %}
    </main>

    {% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    {% elseif nowo_workflow_css_framework == 'foundation' %}
        <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/js/foundation.min.js"></script>
        <script>document.addEventListener('DOMContentLoaded', function () { if (window.Foundation) { $(document).foundation(); } });</script>
    {% endif %}
    {% if nowo_workflow_css_framework not in ['bootstrap5', 'bootstrap4'] %}
        <script>
            document.addEventListener('click', function (event) {
                var openBtn = event.target.closest('[data-nowo-modal-open]');
                if (openBtn) {
                    var id = openBtn.getAttribute('data-nowo-modal-open');
                    var modal = id ? document.getElementById(id) : null;
                    if (modal) { modal.hidden = false; }
                }
                var closeBtn = event.target.closest('[data-nowo-modal-close]');
                if (closeBtn) {
                    var root = closeBtn.closest('.nowo-ui-modal');
                    if (root) { root.hidden = true; }
                }
            });
        </script>
    {% endif %}
    {% block javascripts %}{% endblock %}
</body>
</html>
