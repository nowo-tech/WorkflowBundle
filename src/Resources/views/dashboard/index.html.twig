{% extends '@NowoWorkflowBundle/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

{% block title %}{{ 'page.dashboard'|trans({}, 'NowoWorkflowBundle') }}{% endblock %}

{% block nowo_ui_content %}
    <div class="{{ ui.page_header(nowo_workflow_css_framework) }} mb-4">
        <div>
            <h1 class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}h2 mb-2{% elseif nowo_workflow_css_framework == 'tailwind' %}mb-2 text-2xl font-semibold{% endif %}">{{ 'dashboard.title'|trans({}, 'NowoWorkflowBundle') }}</h1>
            <p class="{{ ui.muted(nowo_workflow_css_framework) }} {% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}mb-0{% elseif nowo_workflow_css_framework == 'tailwind' %}mb-0{% endif %}">{{ 'dashboard.intro'|trans({'%class%': '<code>DatabaseWorkflowRegistry</code>'}, 'NowoWorkflowBundle')|raw }}</p>
        </div>
    </div>

    <div class="{{ ui.card(nowo_workflow_css_framework) }} {% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}shadow-sm{% elseif nowo_workflow_css_framework == 'tailwind' %}overflow-hidden shadow-sm{% endif %}">
        <div class="{{ ui.card_header(nowo_workflow_css_framework) }}">
            <h2 class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}h5 mb-0{% elseif nowo_workflow_css_framework == 'tailwind' %}text-lg font-medium{% endif %}">{{ 'dashboard.definitions'|trans({}, 'NowoWorkflowBundle') }}</h2>
            <a href="{{ path('nowo_workflow_definition_new') }}" class="{{ ui.btn('primary', null, nowo_workflow_css_framework) }}">{{ 'nav.new_definition'|trans({}, 'NowoWorkflowBundle') }}</a>
        </div>
        <div class="{{ ui.card_body(nowo_workflow_css_framework) }}">
            {% if definitions is empty %}
                <div class="{{ ui.empty(nowo_workflow_css_framework) }}">
                    <p class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}mb-0{% elseif nowo_workflow_css_framework == 'tailwind' %}mb-0{% endif %}">
                        {{ 'dashboard.empty_prefix'|trans({}, 'NowoWorkflowBundle') }}
                        <a href="{{ path('nowo_workflow_definition_new') }}">{{ 'action.create_one'|trans({}, 'NowoWorkflowBundle') }}</a>
                        {{ 'dashboard.empty_suffix'|trans({}, 'NowoWorkflowBundle') }}
                        <code>php bin/console nowo:workflow:seed-demo</code>.
                    </p>
                </div>
            {% else %}
                <div class="{{ ui.table_wrap(nowo_workflow_css_framework) }}">
                    <table class="{{ ui.table(nowo_workflow_css_framework) }} {% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}mb-0{% endif %}">
                        <thead class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}table-light{% elseif nowo_workflow_css_framework == 'tailwind' %}bg-slate-50{% endif %}">
                            <tr>
                                <th>{{ 'table.name'|trans({}, 'NowoWorkflowBundle') }}</th>
                                <th>{{ 'table.slug'|trans({}, 'NowoWorkflowBundle') }}</th>
                                <th>{{ 'table.type'|trans({}, 'NowoWorkflowBundle') }}</th>
                                <th>{{ 'table.subject'|trans({}, 'NowoWorkflowBundle') }}</th>
                                <th>{{ 'table.status'|trans({}, 'NowoWorkflowBundle') }}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for definition in definitions %}
                                <tr>
                                    <td class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}fw-semibold{% elseif nowo_workflow_css_framework == 'tailwind' %}font-semibold{% endif %}">{{ definition.name }}</td>
                                    <td><code>{{ definition.slug }}</code></td>
                                    <td>{{ ('workflow_type.' ~ definition.type.value)|trans({}, 'NowoWorkflowBundle') }}</td>
                                    <td><code class="small">{{ definition.subjectClass }}</code></td>
                                    <td>
                                        {% if definition.enabled %}
                                            <span class="{{ ui.badge('success', nowo_workflow_css_framework) }}">{{ 'status.enabled'|trans({}, 'NowoWorkflowBundle') }}</span>
                                        {% else %}
                                            <span class="{{ ui.badge(null, nowo_workflow_css_framework) }}">{{ 'status.disabled'|trans({}, 'NowoWorkflowBundle') }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}text-end{% elseif nowo_workflow_css_framework == 'tailwind' %}text-right{% endif %}">
                                        {% include '@NowoUiKitBundle/partials/_row_actions.html.twig' with {
                                            framework: nowo_workflow_css_framework,
                                            actions: [
                                                {
                                                    kind: 'view',
                                                    href: path('nowo_workflow_definition_show', {id: definition.id}),
                                                    label: 'action.view'|trans({}, 'NowoWorkflowBundle')
                                                }
                                            ]
                                        } %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
    {% include '@NowoWorkflowBundle/_pagination.html.twig' %}
{% endblock %}
