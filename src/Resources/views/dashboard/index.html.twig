{#
  Workflow dashboard — UiKit page/dashboard (REQ-UI-003).

  Variables: page (View\DashboardPage: header, KPI tiles), definitions (first list page of WorkflowDefinition),
  total (all definitions). Data block: nowo_ui_dashboard_cards (the definitions card).
#}
{% extends '@NowoUiKit/page/dashboard.html.twig' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/nowoworkflow/css/nowo-workflow.css') }}">
{% endblock %}

{% block nowo_ui_dashboard_cards %}
    {% set _b = page.bundle %}
    {% set _d = 'NowoWorkflowBundle' %}
    <section class="{{ nowo_ui_class('card', _b) }} nowo-workflow-dashboard__definitions" data-testid="workflow-dashboard-definitions"{{ nowo_ui_attrs('card', _b) }}>
        <header class="{{ nowo_ui_class('card_header', _b) }}">
            <div class="nowo-ui-card__heading">
                <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'dashboard.definitions'|trans({}, _d) }}</h2>
                <p class="{{ nowo_ui_class('card_intro', _b) }}">{{ 'dashboard.definitions_intro'|trans({'%shown%': definitions|length, '%total%': total}, _d) }}</p>
            </div>
            {% if total > definitions|length %}
                <a class="{{ nowo_ui_class('btn_link', _b) }}" href="{{ path('nowo_workflow_definition_index') }}">{{ 'dashboard.view_all'|trans({}, _d) }}</a>
            {% endif %}
        </header>
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            {% if definitions is empty %}
                {{ include(nowo_ui_partial('empty', _b), {message: 'dashboard.empty'|trans({'%command%': 'php bin/console nowo:workflow:seed-demo'}, _d), bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
            {% else %}
                <div class="{{ nowo_ui_class('table_wrap', _b) }}"{{ nowo_ui_attrs('table_wrap', _b) }}>
                    <table class="{{ nowo_ui_class('table', _b) }}"{{ nowo_ui_attrs('table', _b) }}>
                        <thead class="{{ nowo_ui_class('table_head', _b) }}">
                            <tr class="{{ nowo_ui_class('table_head_row', _b) }}">
                                {% for _label in ['table.name', 'table.type', 'table.subject', 'table.status'] %}
                                    <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }}">{{ _label|trans({}, _d) }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for definition in definitions %}
                                <tr class="{{ nowo_ui_class('table_row', _b) }}">
                                    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'table.name'|trans({}, _d) }}">
                                        <a class="nowo-workflow-name" href="{{ path('nowo_workflow_definition_show', {id: definition.id}) }}">{{ definition.name }}</a>
                                    </td>
                                    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'table.type'|trans({}, _d) }}">{{ ('workflow_type.' ~ definition.type.value)|trans({}, _d) }}</td>
                                    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'table.subject'|trans({}, _d) }}"><code>{{ definition.subjectClass }}</code></td>
                                    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'table.status'|trans({}, _d) }}">
                                        <span class="{{ nowo_ui_class(definition.enabled ? 'badge_success' : 'badge_neutral', _b) }}">{{ (definition.enabled ? 'status.enabled' : 'status.disabled')|trans({}, _d) }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
