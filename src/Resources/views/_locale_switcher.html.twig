{#
  Deprecated since 1.9, removed in 2.0 — include @NowoUiKitBundle/partials/_locale_switcher.html.twig (REQ-UI-003).

  Locale switcher of the Workflow UI locales (nowo_workflow.web_ui.locales) rendered by UiKit's switcher.
  Optional: locale_route (default nowo_workflow_locale_switch, receives {_locale}).
#}
{% set _current = app.request.locale %}
{% set _locales = [] %}
{% for locale in nowo_workflow_locales %}
    {% set _locales = _locales|merge([{
        code: locale,
        label: ('locale.' ~ locale)|trans({}, 'NowoWorkflowBundle'),
        href: path(locale_route|default('nowo_workflow_locale_switch'), {_locale: locale}),
        current: locale == _current,
    }]) %}
{% endfor %}
{% if _locales|length > 1 %}
    {{ include('@NowoUiKitBundle/partials/_locale_switcher.html.twig', {locales: _locales, current: _current}, false) }}
{% endif %}
