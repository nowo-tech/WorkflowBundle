{#
  Workflow definition detail — UiKit page/show (REQ-UI-003).

  Variables: page (View\ShowPage: header with edit / delete actions, detail sections general / runtime binding /
  match rules, created / updated meta), definition (WorkflowDefinition), graph (WorkflowGraphPresenter::present()).
  Data blocks: nowo_ui_show_sections (flow diagram before the detail sections); nowo_ui_modals (place / transition
  dialogs of the diagram, UiKit `dialog` partial).
#}
{% extends '@NowoUiKit/page/show.html.twig' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/nowoworkflow/css/nowo-workflow.css') }}">
{% endblock %}

{% block nowo_ui_show_sections %}
    {% if graph.places is empty %}
        {{ include(nowo_ui_partial('empty', page.bundle), {message: 'definition.no_places'|trans({}, 'NowoWorkflowBundle'), bundle: page.bundle, nowo_ui_page_type: nowo_ui_page_type}, false) }}
    {% else %}
        {{ include('@NowoWorkflowBundle/workflow_definition/_flow_diagram.html.twig', {graph: graph, bundle: page.bundle}, false) }}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {{ include('@NowoWorkflowBundle/workflow_definition/_flow_dialogs.html.twig', {graph: graph, bundle: page.bundle}, false) }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# Idempotent: also loaded by the UiKit document layout; kept for host layouts with their own script list. #}
    <script src="{{ asset('js/nowo-ui-dialog.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('bundles/nowoworkflow/js/nowo-workflow.js') }}" defer></script>
{% endblock %}
