{#
  Place / transition dialogs of the flow diagram: the UiKit `dialog` partial (native <dialog>, opened by
  data-nowo-ui-dialog-open and closed by data-nowo-ui-dialog-close / Esc / a backdrop click, js/nowo-ui-dialog.js).
  The transition links of a place dialog also carry data-workflow-dialog-swap (nowo-workflow.js): the place dialog
  closes before the transition dialog opens, so one dialog is open at a time.

  Required: graph (WorkflowGraphPresenter::present()), bundle.
#}
{% set _d = 'NowoWorkflowBundle' %}
{% set _footer %}<button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-nowo-ui-dialog-close>{{ 'action.close'|trans({}, _d) }}</button>{% endset %}
{% for place in graph.places %}
    {% set _id = 'workflow-place-' ~ loop.index0 %}
    {% set _items = [{label: 'diagram.modal.name'|trans({}, _d), value: place.name, href: null}] %}
    {% if place.label %}
        {% set _items = _items|merge([{label: 'diagram.modal.label'|trans({}, _d), value: place.label, href: null}]) %}
    {% endif %}
    {% set _items = _items|merge([{label: 'diagram.modal.sort_order'|trans({}, _d), value: place.sortOrder ~ '', href: null}]) %}
    {% set _title %}
        {{- place.displayLabel }}
        {% if place.isInitial %}<span class="{{ nowo_ui_class('badge_success', bundle) }}">{{ 'status.initial'|trans({}, _d) }}</span>{% endif -%}
    {% endset %}
    {% embed nowo_ui_partial('dialog', bundle) with {id: _id, title: _title, footer: _footer, bundle: bundle} %}
        {% block nowo_ui_dialog_body %}
            {{ include(nowo_ui_partial('detail_list', bundle), {items: _items, bundle: bundle}, false) }}
            {% for _direction in ['incoming', 'outgoing'] %}
                {% set _transitions = attribute(place, _direction) %}
                {% if _transitions %}
                    <h3 class="nowo-workflow-dialog__subtitle">{{ ('diagram.modal.' ~ _direction)|trans({}, _d) }}</h3>
                    <ul class="nowo-workflow-dialog__list">
                        {% for transition in _transitions %}
                            <li>
                                <button type="button" class="{{ nowo_ui_class('btn_link', bundle) }}" data-nowo-ui-dialog-open="workflow-transition-{{ transition.transitionIndex }}" data-workflow-dialog-swap>{{ transition.transitionLabel }}</button>
                                <span class="{{ nowo_ui_class('muted', bundle) }}">
                                    {{ (_direction == 'incoming' ? 'diagram.transition_from' : 'diagram.transition_to')|trans({}, _d) }}
                                    {% for _place in (_direction == 'incoming' ? transition.fromPlaces : transition.toPlaces) %}<code>{{ _place }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
            {% if place.incoming is empty and place.outgoing is empty %}
                <p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'diagram.modal.no_transitions'|trans({}, _d) }}</p>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endfor %}

{% for transition in graph.transitions %}
    {% set _id = 'workflow-transition-' ~ loop.index0 %}
    {% set _items = [{label: 'diagram.modal.name'|trans({}, _d), value: transition.name, href: null}] %}
    {% if transition.label %}
        {% set _items = _items|merge([{label: 'diagram.modal.label'|trans({}, _d), value: transition.label, href: null}]) %}
    {% endif %}
    {% set _items = _items|merge([
        {label: 'diagram.modal.from'|trans({}, _d), value: transition.fromPlaces|join(', '), href: null},
        {label: 'diagram.modal.to'|trans({}, _d), value: transition.toPlaces|join(', '), href: null},
    ]) %}
    {% embed nowo_ui_partial('dialog', bundle) with {id: _id, title: transition.displayLabel, footer: _footer, bundle: bundle} %}
        {% block nowo_ui_dialog_body %}
            {{ include(nowo_ui_partial('detail_list', bundle), {items: _items, bundle: bundle}, false) }}
            <p class="{{ nowo_ui_class('muted', bundle) }}">{{ (graph.type == 'state_machine' ? 'diagram.modal.state_machine_help' : 'diagram.modal.workflow_help')|trans({}, _d) }}</p>
        {% endblock %}
    {% endembed %}
{% endfor %}
