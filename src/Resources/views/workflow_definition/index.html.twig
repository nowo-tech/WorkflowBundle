{#
  Workflow definitions list — UiKit page/list (REQ-UI-003).

  Variable: page (View\ListPage: columns name, slug, matchRules, priority, places, transitions — the four numeric
  columns end-aligned, cells keep the column's nowo-ui-cell--<align>; row actions view,
  edit, delete with confirm; pagination; empty state). Data block: nowo_ui_list_row (cells).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/nowoworkflow/css/nowo-workflow.css') }}">
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _d = 'NowoWorkflowBundle' %}
    <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--start" data-label="{{ 'table.name'|trans({}, _d) }}">
        <a class="nowo-workflow-name" href="{{ path('nowo_workflow_definition_show', {id: row.id}) }}">{{ row.name }}</a>
        {% if not row.enabled %}
            <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ 'status.disabled'|trans({}, _d) }}</span>
        {% endif %}
    </td>
    <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--start" data-label="{{ 'table.slug'|trans({}, _d) }}"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.slug }}</code></td>
    <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end" data-label="{{ 'table.match_rules'|trans({}, _d) }}" data-nowo-ui-priority="2">
        {% if row.defaultMatcher %}
            <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ 'status.default'|trans({}, _d) }}</span>
        {% else %}
            {{ row.matchRules|length }}
        {% endif %}
    </td>
    <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end" data-label="{{ 'table.priority'|trans({}, _d) }}" data-nowo-ui-priority="3">{{ row.priority }}</td>
    <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end" data-label="{{ 'table.places'|trans({}, _d) }}" data-nowo-ui-priority="2">{{ row.places|length }}</td>
    <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end" data-label="{{ 'table.transitions'|trans({}, _d) }}" data-nowo-ui-priority="2">{{ row.transitions|length }}</td>
{% endblock %}
