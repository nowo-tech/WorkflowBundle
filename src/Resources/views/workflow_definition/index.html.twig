{% extends '@NowoWorkflowBundle/base.html.twig' %}
{% import '@NowoWorkflowBundle/_ui_macros.html.twig' as ui %}

{% block title %}{{ 'page.definitions'|trans({}, 'NowoWorkflowBundle') }}{% endblock %}

{% block nowo_ui_content %}
    {% set createBtn %}{{ ui.btn_link(path('nowo_workflow_definition_new'), 'nav.new_definition'|trans({}, 'NowoWorkflowBundle'), 'primary') }}{% endset %}
    {{ ui.page_header('definition.index_title'|trans({}, 'NowoWorkflowBundle'), createBtn) }}

    {{ ui.table_wrap_start() }}
        <table class="{{ ui.table_classes() }}">
            <thead class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}table-light{% elseif nowo_workflow_css_framework == 'tailwind' %}bg-slate-50{% endif %}">
                <tr>
                    <th>{{ 'table.name'|trans({}, 'NowoWorkflowBundle') }}</th>
                    <th>{{ 'table.slug'|trans({}, 'NowoWorkflowBundle') }}</th>
                    <th>{{ 'table.match_rules'|trans({}, 'NowoWorkflowBundle') }}</th>
                    <th>{{ 'table.priority'|trans({}, 'NowoWorkflowBundle') }}</th>
                    <th>{{ 'table.places'|trans({}, 'NowoWorkflowBundle') }}</th>
                    <th>{{ 'table.transitions'|trans({}, 'NowoWorkflowBundle') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for definition in definitions %}
                    <tr>
                        <td class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}fw-semibold{% elseif nowo_workflow_css_framework == 'tailwind' %}font-semibold{% endif %}">{{ definition.name }}</td>
                        <td><code>{{ definition.slug }}</code></td>
                        <td>
                            {% if definition.defaultMatcher %}
                                <span class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}badge text-bg-info{% elseif nowo_workflow_css_framework == 'tailwind' %}rounded bg-sky-100 px-2 py-0.5 text-xs text-sky-800{% endif %}">{{ 'status.default'|trans({}, 'NowoWorkflowBundle') }}</span>
                            {% else %}
                                {{ definition.matchRules|length }}
                            {% endif %}
                        </td>
                        <td>{{ definition.priority }}</td>
                        <td>{{ definition.places|length }}</td>
                        <td>{{ definition.transitions|length }}</td>
                        <td class="{% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}text-end{% elseif nowo_workflow_css_framework == 'tailwind' %}text-right{% endif %}">
                            <div class="nowo-ui-row-actions {% if nowo_workflow_css_framework in ['bootstrap5', 'bootstrap4'] %}btn-group btn-group-sm{% elseif nowo_workflow_css_framework == 'tailwind' %}flex justify-end gap-1{% endif %}">
                                {{ ui.action_link(path('nowo_workflow_definition_show', {id: definition.id}), 'action.show'|trans({}, 'NowoWorkflowBundle'), 'view') }}
                                {{ ui.action_link(path('nowo_workflow_definition_edit', {id: definition.id}), 'action.edit'|trans({}, 'NowoWorkflowBundle'), 'edit') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7">{{ ui.empty_state('definition.none_found'|trans({}, 'NowoWorkflowBundle')) }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    {{ ui.table_wrap_end() }}
    {% include '@NowoWorkflowBundle/_pagination.html.twig' %}
{% endblock %}
