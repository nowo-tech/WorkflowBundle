{#
  Native <dialog> shell of the Workflow pages (diagram details, collection editors). Dialog chrome through the
  UiKit confirm_* slots so it matches the host's confirm dialogs; nowo-workflow.js opens it
  (data-workflow-dialog-open="<id>"), closes it (data-workflow-dialog-close, Esc, backdrop click).

  Required: id, bundle. Blocks: title, body, footer (default: a close button).
  Optional: size (wide), attr / title_attr / body_attr (extra attributes on <dialog>, the title, the body; no on*).
#}
<dialog id="{{ id }}" class="{{ nowo_ui_class('confirm', bundle) }} nowo-workflow-dialog{% if size|default(null) == 'wide' %} nowo-workflow-dialog--wide{% endif %}" aria-labelledby="{{ id }}-title" data-workflow-dialog{{ nowo_ui_attrs('confirm', bundle) }}{{ nowo_ui_html_attrs(attr|default({})) }}>
    <div class="{{ nowo_ui_class('confirm_panel', bundle) }}">
        <header class="{{ nowo_ui_class('confirm_header', bundle) }} nowo-workflow-dialog__header">
            <h2 class="{{ nowo_ui_class('confirm_title', bundle) }}" id="{{ id }}-title"{{ nowo_ui_html_attrs(title_attr|default({})) }}>{% block title %}{% endblock %}</h2>
        </header>
        <div class="{{ nowo_ui_class('confirm_body', bundle) }} nowo-workflow-dialog__body"{{ nowo_ui_html_attrs(body_attr|default({})) }}>
            {% block body %}{% endblock %}
        </div>
        <footer class="{{ nowo_ui_class('confirm_footer', bundle) }}">
            {% block footer %}
                <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-workflow-dialog-close>{{ 'action.close'|trans({}, 'NowoWorkflowBundle') }}</button>
            {% endblock %}
        </footer>
    </div>
</dialog>
